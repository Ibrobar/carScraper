# Copy to .env and edit. Every value here is optional — these are the defaults.

# --- What counts as a deal -------------------------------------------------
# Scrape up to this price so we can watch for price drops into range.
SCRAPE_MAX_PRICE=3200
# Only show listings at or below this. This is your real cap.
FILTER_MAX_PRICE=2500
# Ignore anything below this — almost always parts cars or scams.
FILTER_MIN_PRICE=300
# Origins to REJECT. This is a blocklist, not an allowlist — anything we can't
# confidently identify (including unparseable titles) is kept and shown to you.
# Options: german, korean, other, american, japanese
BLOCKED_ORIGINS=german
# Offer = asking price minus this percent, rounded down to OFFER_ROUND_TO.
OFFER_DISCOUNT_PCT=15
OFFER_ROUND_TO=25

# --- Where to look ---------------------------------------------------------
# Comma-separated metro keys. Defined in lib/config.js: dfw, houston
# Houston is defined but off by default — add it back here to re-enable.
METROS=dfw

# How far from each metro's centre a car may be. THIS is the filter that works.
# Facebook ignores the radius we put in the search URL and serves whatever your
# account's saved Marketplace location says, which is how a DFW search came back
# with 148 Houston, 146 San Antonio and 297 Oklahoma listings.
# DFW measures from Irving; Houston from downtown Houston.
DFW_RADIUS_MILES=150
HOUSTON_RADIUS_MILES=150

# Sent in the search URL. Facebook mostly ignores it — kept so we're at least
# asking for the right thing.
SEARCH_RADIUS_MILES=150

# --- Scraper pacing (be conservative; this is what gets accounts flagged) ---
# Max search result pages to page through per city, per run.
MAX_SEARCH_PAGES=6
# Hard cap on detail-page fetches per run.
#
# This MUST exceed how many new listings a day brings in, or the backlog grows
# forever and recent cars never get checked — which is exactly how the dashboard
# ended up stuck showing Monday's cars on a Wednesday. DFW is ~350-450/day.
# At DETAIL_CONCURRENCY=5 this is roughly half an hour per run.
MAX_DETAIL_FETCHES=800
SEARCH_DELAY_MIN_MS=4000
SEARCH_DELAY_MAX_MS=8000
DETAIL_DELAY_MIN_MS=6000
DETAIL_DELAY_MAX_MS=15000

# Detail pages fetched in parallel. Each worker keeps its own jittered delay,
# so this multiplies speed without removing pacing. 5 takes a ~20 min detail
# pass down to ~4 min.
#
# You can raise this, but understand the trade: one human does not open 50 car
# listings simultaneously, and concurrency is a much louder bot signal than
# total volume is. If the account gets restricted you lose the scraper AND the
# account you'd message sellers from. If you want real speed, PROVIDER=apify
# is the better lever — it returns descriptions in bulk with no page loads
# from this machine at all.
DETAIL_CONCURRENCY=5
# Set to 1 to watch the browser work (useful when selectors break).
HEADFUL=0

# --- Optional: AI description review --------------------------------------
# Leave unset to run keyword-only defect detection. When set, listings with
# ambiguous descriptions get a second-pass review.
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-5

# --- Dashboard -------------------------------------------------------------
DASHBOARD_PORT=5174
# Cars per page. The dashboard works as a review queue: hide the ones you don't
# want and the page refills with the next batch on refresh.
DASHBOARD_PAGE_SIZE=10

# Only show cars first seen in the last N days. Marketplace moves fast, and a
# backlog you'll never get through is worse than no backlog — old listings age
# off the dashboard on their own.
#
# Nothing is deleted: the listings stay in the database, and the day-range
# selector on the dashboard (or ?days=30) brings them back any time.
# Anything you marked "Interested" is exempt and never ages off.
# 0 = no limit.
DASHBOARD_MAX_AGE_DAYS=2

# --- Going live (see docs/DEPLOY.md) ---------------------------------------
# The dashboard ALWAYS binds 127.0.0.1 and there is no setting to change that.
# Reaching it from outside is Cloudflare Tunnel's job: cloudflared runs on this
# machine and dials out, so no port is ever opened on the router.
#
# Leave REQUIRE_AUTH off for normal localhost use. Turn it on BEFORE the tunnel
# goes up — with it off, anything that reaches the port is served.
#
# If REQUIRE_AUTH=1 and either value below is missing, the server refuses to
# start rather than serve the dashboard unprotected.
REQUIRE_AUTH=0
# Application Audience (AUD) tag from your Cloudflare Access application.
# ACCESS_AUD=
# Your Zero Trust team domain, e.g. <yourteam>.cloudflareaccess.com
# ACCESS_TEAM_DOMAIN=
